# All of these are OPTIONAL for local development.
#
# With them unset, the app stores everything in .data/toefl-vocab.json and runs
# with no setup at all. Set them when you want the same vocabulary on another
# device, and before deploying - a serverless deployment has no writable disk,
# so the file backend cannot work there.

# --- Used by the app at runtime ---
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Use the service_role key, NOT the anon key, and never add a NEXT_PUBLIC_
# prefix to it. It bypasses row level security, so it must stay on the server.
# This app has no login: every database call goes through a Next.js route
# handler, which is the only place this key is ever read.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Used only by `npm run migrate`, never by the app ---
# Supabase: Project Settings > Database > Connection string > URI.
# Replace [YOUR-PASSWORD] with the database password you chose when creating
# the project. This is a password, not one of the API keys above.
# Port 5432 (direct or session pooler) is the reliable choice for migrations.
DATABASE_URL=postgresql://postgres:YOUR-PASSWORD@db.xxxxxxxx.supabase.co:5432/postgres

# Optional: where the local JSON file lives. Defaults to .data/toefl-vocab.json.
# LOCAL_DB_PATH=.data/toefl-vocab.json
